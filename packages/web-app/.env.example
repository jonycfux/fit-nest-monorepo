VITE_API_URL=http://localhost:4000

# Clerk — safe to ship to the browser. Dashboard → Configure → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Lets a request carrying the fitnest_dev_user cookie resolve to the seeded
# fixture user instead of a Clerk session, matching the API's flag of the same
# name (ADR 0009). Required for `npm run dev` to honour the cookie, and set by
# the Playwright webServer. Never set this in a real deploy config.
DEV_AUTH_BYPASS=true
